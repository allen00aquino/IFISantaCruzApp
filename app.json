{
  "expo": {
    "name": "IFISantaCruzApp",
    "slug": "IFISantaCruzApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-transparent.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fongelfalco.IFISantaCruzApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo-transparent.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c9972801-07b6-45a4-88cb-16bb6c31398e"
      }
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}